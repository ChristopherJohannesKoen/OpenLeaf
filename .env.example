# Copy to .env for local development. Only DATABASE_URL is required.

# --- required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openleaf

# --- server ---
PORT=3000
LOG_LEVEL=info
# Public address of this API (used when building share links). On Render this is detected automatically.
# PUBLIC_URL=https://openleaf-api.onrender.com
# Which web origins may call the API from a browser: * or a comma-separated list.
CORS_ORIGINS=*

# --- accounts ---
# first-user : only the very first account can be created (it becomes the owner)   [default without INVITE_CODE]
# invite     : anyone who knows INVITE_CODE can create an account                  [default with INVITE_CODE]
# open       : anyone can create an account
# closed     : nobody can
# REGISTRATION=invite
# INVITE_CODE=change-me
SESSION_TTL_DAYS=30

# --- who checks who you are ---
# local    : OpenLeaf keeps a (hashed) password for each account                    [default]
# firebase : people sign in with their Google account through Firebase Authentication;
#            OpenLeaf keeps no password at all. REGISTRATION and INVITE_CODE still decide
#            who may make an account: a new Google account is asked for the invite code once.
# AUTH_PROVIDER=firebase
# From the Firebase project's web app settings. Neither value is a secret.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=AIza...
# Only if it is not <project id>.firebaseapp.com:
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Which Firebase sign-in methods are accepted (comma-separated). Default: google.com
# FIREBASE_SIGN_IN_PROVIDERS=google.com

# --- modules ---
# Core modules (auth, system, projects) are always on. Switch others off:
# OPENLEAF_DISABLED_MODULES=share,templates
# …or list exactly which optional modules to run:
# OPENLEAF_MODULES=files,compile,history

# --- limits ---
MAX_UPLOAD_BYTES=26214400
MAX_PROJECT_BYTES=157286400
MAX_TEXT_FILE_BYTES=2097152
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- compiling ---
DEFAULT_ENGINE=pdflatex
COMPILE_TIMEOUT_MS=180000
COMPILE_CONCURRENCY=1
# How many recent compiles (with their PDFs) to keep per project.
COMPILE_KEEP=3
# restricted (TeX Live's safe list), off, or full (needed for minted; trusted users only)
COMPILE_SHELL_ESCAPE=restricted
# Honour a latexmkrc inside projects (it can run arbitrary code on the server).
ALLOW_LATEXMKRC=false
# default (test the default engine at start-up), all, or off
STARTUP_SELFTEST=default
# COMPILE_DIR=/tmp/openleaf-compiles

# --- history ---
HISTORY_AUTO_INTERVAL_MINUTES=10
HISTORY_AUTO_KEEP=100
