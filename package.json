{
  "name": "openleaf",
  "version": "0.1.0",
  "description": "OpenLeaf — a modular, self-hosted LaTeX writing back end (personal Overleaf-style service).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:native": "sh native/build.sh",
    "selftest": "node dist/selftest-cli.js",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-reporter=spec --test-concurrency=1 test/*.test.ts",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "diff": "^9.0.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
