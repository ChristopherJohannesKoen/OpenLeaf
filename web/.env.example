# Copy to .env.local. Both are optional.

# Where `npm run dev` forwards /api calls. Default: the hosted instance.
# OPENLEAF_API=http://localhost:3000

# Only for a production build served from another origin than the API:
# the API's address, called directly from the browser (the API must allow that origin in CORS_ORIGINS).
# VITE_API_URL=https://openleaf-api.onrender.com
